# --- Core Flask settings ---
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# --- Database ---
# SQLite is fine for a single-shop deployment. For multi-bay / multi-location
# shops, point this at a managed Postgres instance instead.
DATABASE_URL=sqlite:///instance/shop.db

# --- Approval links ---
# Base URL customers see in their SMS/email (no trailing slash).
PUBLIC_BASE_URL=https://approvals.yourshop.example
# How long a one-tap approval link stays valid before it expires.
APPROVAL_LINK_TTL_HOURS=72
# How long a job sits in "waiting on customer" before it's auto-escalated.
WAITING_ON_CUSTOMER_TIMEOUT_HOURS=24

# --- SMS provider (Twilio) ---
# Leave SMS_PROVIDER=console during local development to print messages to
# the log instead of sending real texts.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- File storage for diagnostic photos ---
# "local" stores under instance/uploads. Swap to "s3" in production and set
# the bucket vars below (see docs/DEPLOYMENT.md).
PHOTO_STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_REGION=

# --- Shop defaults ---
SHOP_NAME=Ridgeline Auto Repair
SHOP_PHONE=+15555550123
DEFAULT_CUSTOMER_SPENDING_CAP=500.00
